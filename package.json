{
  "name": "simplysoph-quince",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Static quinceanera website and secure integration handoff",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "start": "node server/start.mjs",
    "pretest": "node scripts/build-pages.mjs --now=2026-10-01T18:00:00Z",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "node scripts/build-pages.mjs --now=2026-10-01T18:00:00Z",
    "test:browser": "playwright test",
    "emails:preview": "node scripts/preview-emails.mjs",
    "sms:setup": "node scripts/twilio-setup.mjs",
    "notion:inspect": "node scripts/inspect-notion.mjs",
    "cleanup:plan": "node scripts/cleanup-plan.mjs",
    "check": "node scripts/build-pages.mjs --now=2026-10-01T18:00:00Z && node scripts/check.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "google-auth-library": "^11.2.0",
    "libphonenumber-js": "^1.13.15",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "twilio": "^6.1.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "axe-core": "4.10.3"
  }
}
