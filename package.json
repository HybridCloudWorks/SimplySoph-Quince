{
  "name": "simplysoph-quince",
  "version": "0.1.0",
  "private": true,
  "description": "Static quinceanera website and secure integration handoff",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "emails:preview": "node scripts/preview-emails.mjs",
    "sms:setup": "node scripts/twilio-setup.mjs",
    "notion:inspect": "node scripts/inspect-notion.mjs",
    "cleanup:plan": "node scripts/cleanup-plan.mjs",
    "check": "node scripts/build-pages.mjs && node scripts/check.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "google-auth-library": "^11.1.0",
    "libphonenumber-js": "^1.13.14",
    "sharp": "^0.35.5",
    "twilio": "^6.1.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4"
  }
}
