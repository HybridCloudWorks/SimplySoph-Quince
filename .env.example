# Local preview: leave EVENT_BUCKET empty (API returns 503, no guest data).
# Production values live in Cloud Run; secrets come from pinned Secret Manager
# versions. Never commit a populated copy. Full reference: docs/deployment.md.
PUBLIC_ORIGIN=https://misxv.simplysoph.com
EVENT_BUCKET=
APP_KEY=
DATA_RETENTION_DATE=

# Notion (Invitations data source)
NOTION_TOKEN=
NOTION_SOURCE_ID=
SCOPED_NOTION_CONNECTION_CONFIRMED=

# Administration
ADMIN_GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=83d9aa10-e1de-455e-a9b8-1cc73e99685a
# Guests' Microsoft sign-in (true or false; administrators' is unaffected).
GUEST_MICROSOFT_SIGN_IN=true
ADMIN_EMAILS=
NOTIFICATION_EMAILS=

# Email (Microsoft Graph primary)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
MAIL_PROVIDER=m365
SENDGRID_API_KEY=
SENDGRID_FALLBACK_ENABLED=false

# Twilio: SMS and WhatsApp are off unless both of their flags are set. SMS: docs/twilio-setup.md. WhatsApp: docs/whatsapp-activation.md.
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
SMS_ENABLED=false
SMS_ACTIVATION_REVIEWED=false
WHATSAPP_FROM=
WHATSAPP_TEMPLATES_JSON=[]
WHATSAPP_ENABLED=false
WHATSAPP_ACTIVATION_REVIEWED=false
# Scheduled drain (both or neither). See docs/deployment.md "Scheduled drain".
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=

# Download all photos: the largest ZIP part, in MB (whole number, 20-1000).
GALLERY_ARCHIVE_PART_MB=100

# Where the server listens. The Dockerfile sets PORT=8080 on Cloud Run, and
# Cloud Run sets K_SERVICE itself (then the default HOST is 0.0.0.0); never
# set K_SERVICE here.
PORT=4173
HOST=127.0.0.1
